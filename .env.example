# Local credentials for factory and evaluation scripts. Copy to .env before use.
# Never prefix secrets with VITE_: Vite exposes those values to the browser.

# Wrangler reads .env too. These names are not Wrangler's own CLOUDFLARE_* names,
# so the Workers AI token never replaces your Wrangler login.
WORKERS_AI_ACCOUNT_ID=
WORKERS_AI_API_TOKEN=

# Keep the Worker dev server from loading this file as Worker secrets.
CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false
