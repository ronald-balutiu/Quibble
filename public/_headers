# Content security policy (plan 3.11, D-57) for every page and asset, including the
# on-device judge's worker script, which gets its own policy from its response.
# Scripts are bundled and self-hosted apart from Turnstile and Cloudflare Web
# Analytics' beacon (D-69), which reports to /cdn-cgi/rum on this origin.
# 'wasm-unsafe-eval' lets onnxruntime compile its WebAssembly runtime; the model
# downloads from Hugging Face, which redirects to its CDN hosts under hf.co.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://huggingface.co https://*.hf.co; img-src 'self' data:; style-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
