{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "quibble",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "quibble.ronaldbalutiu.com", "custom_domain": true }],
  // Serve only the custom domain, so the app has a single public origin.
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "JUDGE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": { "SITE_HOSTNAME": "quibble.ronaldbalutiu.com" },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put): TURNSTILE_SECRET, SESSION_KEY.
}
