{
  "name": "quibble",
  "private": true,
  "version": "0.0.0",
  "description": "Three word games with open-ended answers and two AI judges.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "ts": "tsx --tsconfig tsconfig.node.json",
    "eval": "tsx --tsconfig tsconfig.node.json eval/run.ts",
    "eval:publish": "tsx --tsconfig tsconfig.node.json eval/publish.ts",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:fix": "npm run lint:js -- --fix && npm run lint:css -- --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:device": "playwright test -c playwright.device.config.ts",
    "check:assets": "node scripts/check-assets.mjs",
    "check:bundle": "wrangler deploy --dry-run",
    "check-puzzles": "tsx --tsconfig tsconfig.node.json factory/check-puzzles.ts",
    "preview-puzzles": "tsx --tsconfig tsconfig.node.json factory/preview.ts",
    "check": "npm run build && npm test && npm run check-puzzles && npm run check:assets && npm run check:bundle",
    "deploy": "npm run build && npm run check:assets && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@huggingface/tokenizers": "0.2.0",
    "onnxruntime-web": "1.31.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "miniflare": {
      "undici": "^7.30.1"
    },
    "eslint": {
      "minimatch": "^11.0.3"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.3"
    },
    "eslint-plugin-jsx-a11y-x": {
      "minimatch": "^11.0.3"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261028.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "onnxruntime-common": "1.31.1",
    "onnxruntime-node": "1.31.1",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
